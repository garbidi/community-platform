# Настройки развёртывания. Скопировать в .env рядом и заполнить.
# Это то, что заполняет тот, кто разворачивает, — не Глеб.
# Всё остальное (токен бота, вход в телеграм и Claude) он введёт сам
# в мастере на сайте.

# Домен, по которому будет открываться мастер. Должен уже указывать
# на этот сервер: по нему Caddy сам получит сертификат.
VERSHINA_DOMAIN=assistant.example.com

# Как помощник зовёт хозяина в своих инструкциях (именительный падеж).
VERSHINA_OWNER=Глеб

# Ключи приложения телеграма с my.telegram.org. Наши общие — чтобы
# Глебу не ходить туда самому. При желании можно завести свои.
TG_API_ID=
TG_API_HASH=

# Часовой пояс расписания (ночной прогон и копии).
TZ=Europe/Moscow

# Скопировать в bot.env и заполнить. Файл в репозиторий не попадает.

# Токен бота от @BotFather.
VERSHINA_BOT_TOKEN=

# Кому бот отвечает: телеграм-id через запятую. Свой id бот покажет сам —
# напишите ему что угодно, он ответит отказом и назовёт id.
VERSHINA_BOT_ALLOW=

# Ключ Claude. Без него бот работает на правилах: отвечает выжимками
# из данных, но не связным текстом.
ANTHROPIC_API_KEY=

# Модель и поведение (значения по умолчанию можно не трогать).
# claude-sonnet-5 дешевле опуса примерно в два с половиной раза.
VERSHINA_BOT_MODEL=claude-opus-5
VERSHINA_BOT_THINK=1
VERSHINA_BOT_TRACE=0
